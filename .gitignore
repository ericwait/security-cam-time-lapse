# ==============================================================================
# .gitignore — universal + stack entries (Practices Playbook Pillars II, VI, VIII)
# ==============================================================================

# --- Secrets (Pillar II) ------------------------------------------------------
.env
.env.*
!.env.example

# --- OS junk ------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Editor / IDE directories -------------------------------------------------
.vscode/
.idea/
*.swp
*~

# --- Python dependency + build + tool caches ----------------------------------
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Frontend dependency + build caches --------------------------------
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
playwright-report/
test-results/

# --- Test / coverage output ---------------------------------------------------
htmlcov/
coverage/
.coverage
.coverage.*
*.cover

# --- Local data & SQLite artifacts (Pillar VIII) ------------------------------
# Real captures, previews, caches, and databases never enter git.
data/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# --- Machine-local Compose overrides (host / NAS bind mounts) -----------------
docker-compose.override.yml
