# ==============================================================================
# .env.example — the environment contract (Practices Playbook Pillar II)
#
# This file lists every secret variable the system needs, documented, with safe
# empty placeholders. The real `.env` is gitignored and machine-local — it never
# leaves this machine and is never committed.
#
# SECRETS ONLY belong in `.env`/`.env.example`. Behavior (ports, intervals,
# cache TTLs, feature toggles) lives in reviewed configuration or Admin settings,
# never in unreviewed local environment variables.
#
# Generate local secrets yourself; never share or commit them:
#
#   openssl rand -hex 32
# ==============================================================================

# Master application secret key (32+ hex bytes). Signs user sessions and derives
# the Fernet key that encrypts camera RTSP/HTTP credentials at rest in SQLite.
# Changing this key invalidates active sessions and prevents decrypting stored
# camera passwords unless rotated through the migration utility.
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=

# Initial password for the bootstrap `admin` account when initializing an empty
# database (used by `just dev` and automated deployments). Leave blank in
# production if you prefer to set up the first Admin interactively in the Web UI
# on first visit; required for `just dev`.
# Generate with: openssl rand -hex 16
BOOTSTRAP_ADMIN_PASSWORD=
