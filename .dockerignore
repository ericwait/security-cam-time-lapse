# ==============================================================================
# .dockerignore — keep secrets, local volumes, and host caches out of build context
# ==============================================================================

# --- Version control & local agent/IDE metadata -------------------------------
.git
.gitignore
.github
.claude
.vscode
.idea
.DS_Store
Thumbs.db
Desktop.ini

# --- Secrets (Pillar II — .env NEVER enters Docker build context) -------------
.env
.env.*
!.env.example

# --- Persistent runtime data & SQLite files -----------------------------------
data/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# --- Python virtualenvs & tool caches -----------------------------------------
.venv
**/.venv
**/__pycache__
*.py[cod]
*$py.class
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
.coverage.*
htmlcov
coverage

# --- Frontend & E2E dependencies / build outputs ------------------------------
**/node_modules
frontend/dist
frontend/.vite
*.tsbuildinfo
playwright-report
test-results
